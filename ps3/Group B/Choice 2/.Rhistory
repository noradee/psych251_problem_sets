knitr::opts_chunk$set(echo=TRUE, warning=FALSE, message=FALSE)
library(tidyverse) # for data munging
library(knitr) # for kable table formating
library(haven) # import and export 'SPSS', 'Stata' and 'SAS' Files
library(readxl) # import excel files
# #optional packages:
# library(psych)
# library(car) # for ANCOVA
# library(compute.es) # for ANCOVA
# library(lsmeans) # for ANCOVA
# Just Experiment 1
d <-read_csv("data/S1_voice_level_Final.csv")
# DT::datatable(d)
d %>%
group_by(plev) %>%
summarize(mean_form_s = mean(form_smean),
mean_form_r = mean(form_rmean),
mean_intense_s = mean(intense_smean),
mean_intense_r = mean(intense_rmean),
mean_pitch_s = mean(pitch_smean),
mean_pitch_r = mean(pitch_rmean))
d %>%
group_by(plev) %>%
summarize(mean_form_s = mean(Zform_smean),
mean_form_r = mean(Zform_rmean),
mean_intense_s = mean(Zintense_smean),
mean_intense_r = mean(Zintense_rmean),
mean_pitch_s = mean(Zpitch_smean),
mean_pitch_r = mean(Zpitch_rmean))
d %>%
group_by(plev) %>%
summarize(mean_form_s = mean(formant_smeanMD),
mean_form_r = mean(formant_rmeanMD),
mean_intense_s = mean(intense_smeanMD),
mean_intense_r = mean(intense_rmeanMD),
mean_pitch_s = mean(pitch_smeanMD),
mean_pitch_r = mean(pitch_rmeanMD))
d %>%
group_by(plev) %>%
summarize(adjusted_form_s = mean(form_smean) - mean(formant_smeanMD),
adjusted_form_r = mean(form_rmean) - mean(formant_rmeanMD),
adjusted_intense_s = mean(intense_smean) - mean(intense_smeanMD),
adjusted_intense_r = mean(intense_rmean) - mean(intense_rmeanMD),
adjusted_pitch_s = mean(pitch_smean) - mean(pitch_smeanMD),
adjusted_pitch_r = mean(pitch_rmean) - mean(pitch_rmeanMD))
library(emmeans)
model <- lm(formant_rmeanMD ~ plev + formant_smeanMD, data = d)
emmeans(model, ~ plev)
# i think this is right?? maybe??
model2 <- lm(form_rmean ~ plev + form_smean, data = d)
emmeans(model2, ~ plev)
model3 <- lm(pitch_rmean ~ plev + pitch_smean, data = d)
emmeans(model3, ~ plev)
# reproduce the above results here
View(d)
model2 <- lm(form_rmean ~ plev + form_smean, data = d)
emmeans(model2, ~ plev)
resonance <- lm(form_rmean ~ plev + form_smean, data = d)
emmeans(resonance, ~ plev)
loudness <- lm(intense_rmean ~ plev + intense_smean, data = d)
emmeans(loudness, ~ plev)
pitch <- lm(pitch_rmean ~ plev + pitch_smean, data = d)
emmeans(pitch, ~ plev)
pitch <- lm(pitch_rmean ~ plev + pitch_smean, data = d)
emmeans(pitch, ~ plev)
pitch_variability <- lm(pitch_rvar ~ plev + pitch_svar, data = d)
emmeans(pitch_variability, ~ plev)
loudness <- lm(intense_rmean ~ plev + intense_smean, data = d)
emmeans(loudness, ~ plev)
loudness_variability <- lm(intense_rvar ~ plev + intense_svar, data = d)
emmeans(loudness_variability, ~ plev)
resonance <- lm(form_rmean ~ plev + form_smean, data = d)
emmeans(resonance, ~ plev)
resonance_variability <- lm(form_rvar ~ plev + form_svar, data = d)
emmeans(resonance_variability, ~ plev)
pitch <- lm(pitch_rmean ~ plev + pitch_smean  + voice, data = d)
emmeans(pitch, ~ plev)
pitch_variability <- lm(pitch_rvar ~ plev + pitch_svar + voice, data = d)
emmeans(pitch_variability, ~ plev)
pitch <- lm(pitch_rmean ~ plev + pitch_smean, data = d)
emmeans(pitch, ~ plev)
pitch_variability <- lm(pitch_rvar ~ plev + pitch_svar, data = d)
emmeans(pitch_variability, ~ plev)
# #optional packages:
# library(psych)
library(car) # for ANCOVA
?anova_test
?aov
# reproduce the above results here
aov(pitch_rmean ~ plev*vsex, data = d)
aov(pitch_rmean ~ plev*vsex + pitch_smean, data = d)
aov(pitch_rvar ~ plev*vsex + pitch_svar, data = d)
test <- aov(pitch_rmean ~ plev*vsex + pitch_smean, data = d)
anova(test)
pitch_ancova <- aov(pitch_rmean ~ plev*vsex + pitch_smean, data = d)
anova(pitch_ancova)
pitch_variance_ancova <- aov(pitch_rvar ~ plev*vsex + pitch_svar, data = d)
anova(pitch_variance_ancova)
pitch_ancova <- aov(pitch_rmean ~ plev*vsex + pitch_smean, data = d)
anova(pitch_ancova)
pitch_ancova <- aov(pitch_rmean ~ plev*vsex + pitch_smean, data = d)
anova(pitch_ancova)
pitch_variance_ancova <- aov(pitch_rvar ~ plev*vsex + pitch_svar, data = d)
anova(pitch_variance_ancova)
intensity_ancova <- aov(intense_rmean ~ plev*vsex + intense_smean, data = d)
anova(intensity_ancova)
intensity_variance_ancova <- aov(intense_rvar ~ plev*vsex + intense_svar, data = d)
anova(intensity_variance_ancova)
resonance_ancova <- aov(form_rmean ~ plev*vsex + form_smean, data = d)
anova(resonance_ancova)
resonance_variance_ancova <- aov(form_rvar ~ plev*vsex + form_svar, data = d)
anova(resonance_variance_ancova)
