# run simulation
double.sample <- function(sample_size, min_pval, max_pval) {
sample <- rnorm(n = sample_size, mean = mean, sd = 1)
test <- t.test(sample, mu = 0, alternative = 'two.sided')
p_value <- test$p.val
while (p_value < max_pval & p_value > min_pval) {
sample <- rnorm(n = sample_size, mean = mean, sd = 1)
test <- t.test(sample, mu = 0, alternative = 'two.sided')
p_value <- test$p.val
}
return(p_value)
}
