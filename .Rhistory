summary()
lmer(hand.look ~ condition*age + (1 | subid), data = fvs) %>%
summary()
model <- lmer(hand.look ~ condition*age + (1 | subid), data = fvs) %>%
summary()
null <- lmer(hand.look ~ condition+age + (1 | subid), data = fvs) %>%
summary()
fit.augmented <- lmer(hand.look ~ condition*age + (1 | subid), data = fvs) %>%
summary()
fit.compact <- lmer(hand.look ~ condition+age + (1 | subid), data = fvs) %>%
summary()
anova(fit.augmented, fit.compact)
anova(fit.augmented, fit.compact)
